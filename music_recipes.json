{
  "$comment": "Per-genre recipes and platform loudness presets for the music scripts (music_analyze.py, process_music_wav.py, pick_clip.py, release.py). Same rules as recipes.json: a genre missing a required key makes the scripts refuse to run, and every genre is flagged \"untested\": true until it has been A/B'd against real Bluebox mixes at matched loudness. The preset sets the loudness target; the genre sets the sound.",

  "presets": {
    "youtube": {
      "target_i": -14.0,
      "target_tp": -1.0,
      "note": "YouTube's commonly-cited loudness reference -- louder uploads are turned down, so going hotter gains nothing. -1 dBTP leaves room for the AAC re-encode's inter-sample overs."
    },
    "instagram": {
      "target_i": -14.0,
      "target_tp": -1.0,
      "untested": true,
      "note": "Instagram publishes no loudness target -- treated like YouTube until measured. Upload a private test Reel, download it back, and run music_analyze.py on it before trusting this number."
    }
  },

  "genres": {
    "ambient": {
      "untested": true,
      "tempo_range": [60, 120],
      "expect_grid": false,
      "phrase_bars": 8,
      "highpass_hz": 25,
      "mono_bass_hz": 100,
      "eq": "equalizer=f=300:t=q:w=1.0:g=-1.0,highshelf=f=10000:g=1.0",
      "dynamic_eq": null,
      "glue": {"threshold_db": -20, "ratio": 1.5, "attack_ms": 40, "release_ms": 400, "knee_db": 6},
      "softclip": null,
      "width": 1.0,
      "loudness_offset_lu": -2.0,
      "fade_in": 2.0,
      "fade_out": 4.0,
      "clip_fade_in": 1.5,
      "clip_fade_out": 2.5,
      "tilt_reference_db_per_octave": null,
      "visual_style": "glowburst",
